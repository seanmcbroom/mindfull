{
  "manifest_version": 3,
  "name": "Mindfull — pause before you scroll",
  "short_name": "Mindfull",
  "version": "0.1.0",
  "description": "Puts a short wait in front of the sites you open on autopilot, with daily limits, restricted hours, focus sessions and friction for turning it off.",

  "browser_specific_settings": {
    "gecko": {
      "id": "mindfull@extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["src/background.js"]
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Mindfull",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["src/pause.html", "src/pause.js", "src/pause.css", "src/ui.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
